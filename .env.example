# Vrinzu environment variables
#
# 1. Copy this file to `.env.local` in the project root:
#      cp .env.example .env.local
# 2. In your Supabase dashboard open  Project Settings -> API  (or "Connect")
#    and copy the Project URL and the anon / publishable key into the values below.
# 3. Restart `npm start` — Create React App only reads env vars at startup.
#
# On Vercel, add the same two variables under
#   Project -> Settings -> Environment Variables
# and redeploy. Never commit `.env.local` (it is already in .gitignore).
#
# The anon key is safe to expose in the browser: Row Level Security in
# supabase-schema.sql makes sure every user can only read their own data.

REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key
